<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= settings.name %> - Dashboard</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bulma@0.9.4/css/bulma.min.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
  <script defer src="https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.13.3/cdn.min.js"></script>
  <link rel="icon" href="<%= settings.favicon %>">

  <style>
    :root {
      --accent-color: <%=accentColorHex %>;
      --accent-color-rgb: <%=accentColorRgb %>;
      --bg-primary: #0a0a0f;
      --bg-secondary: #111118;
      --bg-tertiary: #1c1c28;
      --bg-card: #1f1f2e;
      --text-primary: #ffffff;
      --text-secondary: #e2e8f0;
      --text-muted: #94a3b8;
      --text-subtle: #64748b;
      --border-color: rgba(255, 255, 255, 0.08);
      --border-hover: rgba(255, 255, 255, 0.15);
      --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
      --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
      --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
      --shadow-xl: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg-primary);
      color: var(--text-secondary);
      line-height: 1.6;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: 
        radial-gradient(600px circle at 40% 40%, rgba(var(--accent-color-rgb), 0.08), transparent 40%),
        radial-gradient(800px circle at 80% 10%, rgba(var(--accent-color-rgb), 0.05), transparent 40%),
        radial-gradient(400px circle at 20% 80%, rgba(var(--accent-color-rgb), 0.03), transparent 40%);
      pointer-events: none;
      z-index: 0;
    }

    .main-content {
      flex: 1;
      position: relative;
      z-index: 1;
    }

    .section {
      padding: 2rem 1.5rem;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .page-title {
      font-size: 2rem;
      font-weight: 700;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
      letter-spacing: -0.01em;
    }

    .page-subtitle {
      color: var(--text-muted);
      font-size: 1rem;
      font-weight: 400;
    }

    .quick-actions {
      display: flex;
      gap: 1rem;
      margin-bottom: 2rem;
      flex-wrap: wrap;
    }

    .quick-action-btn {
      padding: 0.75rem 1.5rem;
      background: linear-gradient(135deg, var(--accent-color), rgba(var(--accent-color-rgb), 0.9));
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(var(--accent-color-rgb), 0.3);
      cursor: pointer;
    }

    .quick-action-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(var(--accent-color-rgb), 0.4);
      color: white;
    }

    .quick-action-btn.secondary {
      background: var(--bg-card);
      color: var(--text-primary);
      border: 1px solid var(--border-color);
      box-shadow: var(--shadow-md);
    }

    .quick-action-btn.secondary:hover {
      border-color: var(--border-hover);
      color: var(--text-primary);
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 3rem;
    }

    .stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.25s ease;
      position: relative;
      overflow: hidden;
    }

    .stat-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--stat-color);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }

    .stat-card:hover {
      transform: translateY(-4px);
      border-color: var(--border-hover);
      box-shadow: var(--shadow-xl);
    }

    .stat-card:hover::before {
      transform: scaleX(1);
    }

    .stat-card.total { --stat-color: var(--accent-color); }
    .stat-card.clicks { --stat-color: #10b981; }
    .stat-card.today { --stat-color: #fbbf24; }
    .stat-card.top { --stat-color: #3b82f6; }

    .stat-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1rem;
    }

    .stat-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      background: rgba(var(--accent-color-rgb), 0.1);
      color: var(--accent-color);
      border: 1px solid rgba(var(--accent-color-rgb), 0.2);
    }

    .stat-card.clicks .stat-icon {
      background: rgba(16, 185, 129, 0.1);
      color: #10b981;
      border-color: rgba(16, 185, 129, 0.2);
    }

    .stat-card.today .stat-icon {
      background: rgba(251, 191, 36, 0.1);
      color: #fbbf24;
      border-color: rgba(251, 191, 36, 0.2);
    }

    .stat-card.top .stat-icon {
      background: rgba(59, 130, 246, 0.1);
      color: #3b82f6;
      border-color: rgba(59, 130, 246, 0.2);
    }

    .stat-value {
      font-size: 2rem;
      font-weight: 800;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
      line-height: 1;
    }

    .stat-label {
      color: var(--text-muted);
      font-size: 0.875rem;
      font-weight: 500;
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--text-primary);
      margin-bottom: 0.5rem;
    }

    .section-description {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .links-grid {
      display: grid;
      gap: 1rem;
    }

    .link-card {
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 1.5rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .link-card:hover {
      border-color: var(--border-hover);
      transform: translateX(4px);
      box-shadow: var(--shadow-md);
    }

    .link-icon {
      width: 40px;
      height: 40px;
      background: rgba(var(--accent-color-rgb), 0.1);
      border: 1px solid rgba(var(--accent-color-rgb), 0.2);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .link-icon i {
      color: var(--accent-color);
      font-size: 1rem;
    }

    .link-content {
      flex-grow: 1;
      min-width: 0;
      overflow: hidden;
    }

    .link-short {
      color: var(--text-primary);
      font-weight: 600;
      margin-bottom: 0.25rem;
      font-family: 'Monaco', 'Menlo', monospace;
      font-size: 0.95rem;
      word-break: break-all;
      overflow-wrap: break-word;
    }

    .link-original {
      color: var(--text-subtle);
      font-size: 0.875rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
      word-break: break-all;
    }

    .link-stats {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: var(--text-muted);
      font-size: 0.875rem;
    }

    .link-stat {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    .link-stat i {
      color: var(--accent-color);
      font-size: 0.75rem;
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      background: var(--bg-card);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      backdrop-filter: blur(10px);
    }

    .empty-state-icon {
      font-size: 2.5rem;
      color: var(--accent-color);
      margin-bottom: 1rem;
      opacity: 0.6;
    }

    .empty-state-text {
      color: var(--text-muted);
      font-size: 1rem;
      margin-bottom: 1.5rem;
    }

    .fade-in {
      opacity: 0;
      animation: fadeIn 0.4s ease-out forwards;
    }

    .stagger-animation {
      opacity: 0;
      animation: fadeIn 0.3s ease-out forwards;
      animation-delay: calc(var(--stagger-delay, 0) * 0.05s);
    }

    @keyframes fadeIn {
      from { 
        opacity: 0; 
        transform: translateY(8px); 
      }
      to { 
        opacity: 1; 
        transform: translateY(0); 
      }
    }

    @media (max-width: 1024px) {
      .stats-grid {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
    }

    @media (max-width: 768px) {
      .section {
        padding: 2rem 1rem;
      }

      .page-title {
        font-size: 1.75rem;
      }

      .link-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 1rem;
      }

      .link-content {
        width: 100%;
        overflow: hidden;
      }

      .link-original {
        max-width: none;
        white-space: normal;
        word-break: break-word;
        overflow-wrap: break-word;
        line-height: 1.4;
      }

      .link-stats {
        justify-content: space-between;
        width: 100%;
      }

      .quick-actions {
        flex-direction: column;
        align-items: stretch;
      }

      .quick-action-btn {
        justify-content: center;
      }

      .stats-grid {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 1rem;
      }

      .stat-card {
        padding: 1.25rem;
      }

      .stat-value {
        font-size: 1.75rem;
      }
    }
  </style>
</head>

<body>
  <%- include('partials/header', { user: user, isStaff: isStaff }) %>
  
  <main class="main-content">
    <section class="section">
      <div class="container">
        <div class="page-header fade-in">
          <h1 class="page-title">Dashboard</h1>
          <p class="page-subtitle">Manage your links and track performance</p>
        </div>

        <div class="quick-actions fade-in">
          <% if (isStaff) { %>
            <a href="/staff" class="quick-action-btn">
              <i class="fas fa-plus"></i>
              Create Link
            </a>
          <% } %>
          <a href="/analytics" class="quick-action-btn secondary">
            <i class="fas fa-chart-line"></i>
            Analytics
          </a>
        </div>

        <div class="stats-grid fade-in">
          <div class="stat-card total">
            <div class="stat-header">
              <div class="stat-icon">
                <i class="fas fa-link"></i>
              </div>
            </div>
            <div class="stat-value"><%= stats.totalLinks %></div>
            <div class="stat-label">Total Links</div>
          </div>
          
          <div class="stat-card clicks">
            <div class="stat-header">
              <div class="stat-icon">
                <i class="fas fa-mouse-pointer"></i>
              </div>
            </div>
            <div class="stat-value"><%= stats.totalClicks %></div>
            <div class="stat-label">Total Clicks</div>
          </div>
          
          <div class="stat-card today">
            <div class="stat-header">
              <div class="stat-icon">
                <i class="fas fa-calendar-day"></i>
              </div>
            </div>
            <div class="stat-value"><%= stats.todayClicks %></div>
            <div class="stat-label">Today's Clicks</div>
          </div>
          
          <div class="stat-card top">
            <div class="stat-header">
              <div class="stat-icon">
                <i class="fas fa-fire"></i>
              </div>
            </div>
            <div class="stat-value"><%= stats.topLink %></div>
            <div class="stat-label">Top Link</div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-header fade-in">
          <h2 class="section-title">Recent Links</h2>
          <p class="section-description">Your most recently created links</p>
        </div>

        <div class="links-grid">
          <% if (links.length > 0) { %>
            <% links.forEach((link, index) => { %>
              <div class="link-card stagger-animation" style="--stagger-delay: <%= index %>">
                <div class="link-icon">
                  <i class="fas fa-external-link-alt"></i>
                </div>
                
                <div class="link-content">
                  <div class="link-short"><%= host %>/<%= link.slug %></div>
                  <div class="link-original" title="<%= link.originalUrl %>"><%= link.originalUrl %></div>
                </div>
                
                <div class="link-stats">
                  <div class="link-stat">
                    <i class="fas fa-mouse-pointer"></i>
                    <span><%= link.clicks %> clicks</span>
                  </div>
                  <div class="link-stat">
                    <i class="fas fa-calendar"></i>
                    <span><%= new Intl.DateTimeFormat('en-US', { 
                      month: 'short',
                      day: 'numeric',
                      year: 'numeric'
                    }).format(new Date(link.createdAt)) %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="empty-state fade-in">
              <i class="fas fa-link empty-state-icon"></i>
              <p class="empty-state-text">No links created yet</p>
              <div style="display: flex; justify-content: center;">
                <% if (isStaff) { %>
                  <a href="/staff" class="quick-action-btn">
                    <i class="fas fa-plus"></i>
                    Create Your First Link
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </main>

<%- include('partials/footer') %>

  <script>
    function plexLinksHandler() {
      return {
        showCreateModal: false,
        
        initPage() {
          console.log('Plex Links dashboard initialized');
        }
      }
    }
  </script>
</body>
</html>